plasma_genes <- toupper(plasma_genes)
mitra_genes <- toupper(mitra_genes)
# Perform ORA for Plasma sample using GO terms
ora_plasma_go <- enrichGO(gene = plasma_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "ALL",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
# Perform ORA for Mitra sample using GO terms
ora_mitra_go <- enrichGO(gene = mitra_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "ALL",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
# View results
cat("ORA Results for Plasma Sample (GO Terms):\n")
print(head(ora_plasma_go))
cat("\nORA Results for Mitra Sample (GO Terms):\n")
print(head(ora_mitra_go))
# Plot results
barplot(ora_plasma_go, showCategory = 20, title = "ORA for Plasma Sample (GO Terms)")
barplot(ora_mitra_go, showCategory = 20, title = "ORA for Mitra Sample (GO Terms)")
# Generate dot plot for Plasma sample ORA results
dotplot(ora_plasma_go, showCategory = 20, title = "ORA for Plasma Sample (GO Terms)")
# Generate dot plot for Mitra sample ORA results
dotplot(ora_mitra_go, showCategory = 20, title = "ORA for Mitra Sample (GO Terms)")
# Perform ORA for Plasma sample using GO terms for CC, MF, and BP separately
ora_plasma_go_cc <- enrichGO(gene = plasma_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "CC",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
ora_plasma_go_mf <- enrichGO(gene = plasma_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "MF",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
ora_plasma_go_bp <- enrichGO(gene = plasma_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "BP",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
# Perform ORA for Mitra sample using GO terms for CC, MF, and BP separately
ora_mitra_go_cc <- enrichGO(gene = mitra_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "CC",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
ora_mitra_go_mf <- enrichGO(gene = mitra_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "MF",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
ora_mitra_go_bp <- enrichGO(gene = mitra_genes,
OrgDb = org.Hs.eg.db,
keyType = "SYMBOL",
ont = "BP",
pvalueCutoff = 0.05,
qvalueCutoff = 0.05)
# View results for Plasma sample
cat("ORA Results for Plasma Sample (GO CC Terms):\n")
print(head(ora_plasma_go_cc))
cat("\nORA Results for Plasma Sample (GO MF Terms):\n")
print(head(ora_plasma_go_mf))
cat("\nORA Results for Plasma Sample (GO BP Terms):\n")
print(head(ora_plasma_go_bp))
# View results for Mitra sample
cat("ORA Results for Mitra Sample (GO CC Terms):\n")
print(head(ora_mitra_go_cc))
cat("\nORA Results for Mitra Sample (GO MF Terms):\n")
print(head(ora_mitra_go_mf))
cat("\nORA Results for Mitra Sample (GO BP Terms):\n")
print(head(ora_mitra_go_bp))
# Plot results as dot plots
dotplot(ora_plasma_go_cc, showCategory = 20, title = "ORA for Plasma Sample (GO CC Terms)",
color = "p.adjust", size = "GeneRatio")
dotplot(ora_plasma_go_mf, showCategory = 20, title = "ORA for Plasma Sample (GO MF Terms)",
color = "p.adjust", size = "GeneRatio")
dotplot(ora_plasma_go_bp, showCategory = 20, title = "ORA for Plasma Sample (GO BP Terms)",
color = "p.adjust", size = "GeneRatio")
dotplot(ora_mitra_go_cc, showCategory = 20, title = "ORA for Mitra Sample (GO CC Terms)",
color = "p.adjust", size = "GeneRatio")
dotplot(ora_mitra_go_mf, showCategory = 20, title = "ORA for Mitra Sample (GO MF Terms)",
color = "p.adjust", size = "GeneRatio")
dotplot(ora_mitra_go_bp, showCategory = 20, title = "ORA for Mitra Sample (GO BP Terms)",
color = "p.adjust", size = "GeneRatio")
